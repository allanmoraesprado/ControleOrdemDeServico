@page "/customers"
@rendermode InteractiveServer
@inject OsServiceApiClient Api

<section class="os-section">
    <div class="container os-container">
        <header class="os-section-header">
            <h1 class="os-title">Customers</h1>
            <p class="os-subtitle">
                Register new customers and search existing records.
            </p>
        </header>

        @if (!string.IsNullOrEmpty(_createError))
        {
            <div class="os-alert os-alert-danger">
                <div class="os-alert-icon">!</div>
                <div class="os-alert-body">
                    <div class="os-alert-title">Something went wrong</div>
                    <div class="os-alert-message">@_createError</div>
                </div>
            </div>
        }
        
        @if (_currentCustomer is not null)
        {
            <section class="os-details mt-4 mb-5">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h3 class="os-details-title mb-0">Customer details</h3>

                    @if (!string.IsNullOrEmpty(_createSuccess))
                    {
                        <span class="os-badge os-badge-success">Customer created</span>
                    }
                    else
                    {
                        <span class="os-badge os-badge-info">Search result</span>
                    }
                </div>

                <div class="os-panel os-details-panel @(string.IsNullOrEmpty(_createSuccess) ? "" : "os-details-panel-success")">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <p class="os-detail-line"><span>Id</span> @_currentCustomer.Id</p>
                            <p class="os-detail-line"><span>Name</span> @_currentCustomer.Name</p>
                            <p class="os-detail-line"><span>Phone</span> @_currentCustomer.Phone</p>
                        </div>
                        <div class="col-md-6">
                            <p class="os-detail-line"><span>Email</span> @_currentCustomer.Email</p>
                            <p class="os-detail-line"><span>Document</span> @_currentCustomer.Document</p>
                            <p class="os-detail-line"><span>Created at (UTC)</span> @_currentCustomer.CreatedAt</p>
                        </div>
                    </div>
                </div>
            </section>
        }

        <div class="row g-4 os-form-row">
            <!-- Create customer -->
            <div class="col-lg-6">
                <div class="os-panel">
                    <h2 class="os-panel-title">Create customer</h2>
                    <p class="os-panel-subtitle">
                        Fields marked with <span class="os-required">*</span> are required.
                    </p>

                    <div class="os-field">
                        <label class="os-label">Name <span class="os-required">*</span></label>
                        <input class="form-control os-input"
                               placeholder="Customer name"
                               @bind="_createModel.Name" />
                    </div>

                    <div class="os-field">
                        <label class="os-label">Phone</label>
                        <input class="form-control os-input"
                               placeholder="+55 (11) 99999-9999"
                               @bind="_createModel.Phone" />
                    </div>

                    <div class="os-field">
                        <label class="os-label">Email</label>
                        <input class="form-control os-input"
                               placeholder="name@company.com"
                               @bind="_createModel.Email" />
                    </div>

                    <div class="os-field">
                        <label class="os-label">Document</label>
                        <input class="form-control os-input"
                               placeholder="CPF / CNPJ"
                               @bind="_createModel.Document" />
                    </div>

                    <button class="btn os-btn-primary os-btn-primary-main mt-3"
                            @onclick="CreateCustomerAsync">
                        Create customer
                    </button>
                </div>
            </div>

            <!-- Find customer -->
            <div class="col-lg-6">
                <div class="os-panel">
                    <h2 class="os-panel-title">Find customer</h2>
                    <p class="os-panel-subtitle">
                        Search by Id, phone or document.
                    </p>

                    <div class="os-field">
                        <label class="os-label">Customer Id</label>
                        <input class="form-control os-input"
                               placeholder="GUID"
                               @bind="_searchById" />
                    </div>

                    <button class="btn os-btn-secondary mb-4"
                            @onclick="GetCustomerByIdAsync">
                        Get by Id
                    </button>

                    <div class="os-divider">
                        <span>or</span>
                    </div>

                    <div class="os-field">
                        <label class="os-label">Phone</label>
                        <input class="form-control os-input"
                               placeholder="+55 (11) 99999-9999"
                               @bind="_searchPhone" />
                    </div>

                    <div class="os-field">
                        <label class="os-label">Document</label>
                        <input class="form-control os-input"
                               placeholder="CPF / CNPJ"
                               @bind="_searchDocument" />
                    </div>

                    <button class="btn os-btn-outline mt-3"
                            @onclick="SearchCustomerAsync">
                        Search by phone / document
                    </button>
                </div>
            </div>
        </div>       
    </div>
</section>

@code {
    private CreateCustomerModel _createModel = new();
    private string? _createError;
    private string? _createSuccess;

    private string? _searchById;
    private string? _searchPhone;
    private string? _searchDocument;

    private CustomerResponse? _currentCustomer;

    private sealed class CreateCustomerModel
    {
        public string Name { get; set; } = string.Empty;
        public string? Phone { get; set; }
        public string? Email { get; set; }
        public string? Document { get; set; }
    }

    private async Task CreateCustomerAsync()
    {
        _createError = null;
        _createSuccess = null;
        _currentCustomer = null;

        try
        {
            var req = new CreateCustomerRequest(
                _createModel.Name,
                _createModel.Phone,
                _createModel.Email,
                _createModel.Document);

            var id = await Api.CreateCustomerAsync(req);
            _createSuccess = $"Customer created with Id {id}.";
            _currentCustomer = await Api.GetCustomerByIdAsync(id);

            _createModel = new CreateCustomerModel();
        }
        catch (ApiException ex)
        {
            _createError = ex.Message;
        }
        catch (Exception)
        {
            _createError = "An unexpected error occurred.";
        }
    }

    private async Task GetCustomerByIdAsync()
    {
        _currentCustomer = null;

        if (!Guid.TryParse(_searchById, out var id))
        {
            _createError = "Invalid GUID for Id.";
            return;
        }

        _createError = null;
        _createSuccess = null;

        try
        {
            _currentCustomer = await Api.GetCustomerByIdAsync(id);
            if (_currentCustomer is null)
                _createError = "Customer not found.";
        }
        catch (ApiException ex)
        {
            _createError = ex.Message;
        }
        catch (Exception)
        {
            _createError = "An unexpected error occurred.";
        }
    }

    private async Task SearchCustomerAsync()
    {
        _createError = null;
        _createSuccess = null;
        _currentCustomer = null;

        try
        {
            var result = await Api.SearchCustomerAsync(_searchPhone, _searchDocument);
            if (result is null)
            {
                _createError = "Customer not found.";
            }
            else
            {
                _currentCustomer = result;
            }
        }
        catch (ApiException ex)
        {
            _createError = ex.Message;
        }
        catch (Exception)
        {
            _createError = "An unexpected error occurred.";
        }
    }
}