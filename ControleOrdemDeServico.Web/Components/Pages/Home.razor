@page "/"

<section class="home-hero">
    <div class="container home-hero-content">
        <p class="home-eyebrow">Service Orders panel</p>

        <h1>
            <span class="home-highlight">A partner you can trust</span><br />
            to organize your service orders.
        </h1>

        <p class="home-subtitle">
            Register customers, open orders and track price and status
            in a single, simple web panel.
        </p>

        <div class="home-hero-actions">
            <NavLink href="service-orders" class="btn btn-primary">
                Open a service order
            </NavLink>
            <NavLink href="customers" class="btn btn-outline-light ms-3">
                Register a customer
            </NavLink>
        </div>
    </div>
</section>

<section class="home-summary">
    <div class="container home-summary-grid">
        <div class="card home-card">
            <div class="card-body">
                <h3 class="card-title">Customers</h3>
                <p class="card-text">
                    Register new customers and find them quickly by Id, phone or document.
                </p>
                <ul>
                    <li>Create customer</li>
                    <li>Get customer by Id</li>
                    <li>Search by phone / document</li>
                </ul>
                <NavLink href="customers" class="btn btn-link p-0 mt-2">
                    Go to Customers →
                </NavLink>
            </div>
        </div>

        <div class="card home-card">
            <div class="card-body">
                <h3 class="card-title">Service Orders</h3>
                <p class="card-text">
                    Open new service orders, define price and track the full lifecycle.
                </p>
                <ul>
                    <li>Open service order</li>
                    <li>Check current status</li>
                    <li>View pricing information</li>
                </ul>
                <NavLink href="service-orders" class="btn btn-link p-0 mt-2">
                    Go to Service Orders →
                </NavLink>
            </div>
        </div>
    </div>
</section>